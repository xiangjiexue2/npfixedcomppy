# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/

# Virtual environments
.venv/
.venv-*/

# C++ / MSVC build artifacts
*.obj
*.ilk
*.pdb
*.mdmp
*.bin
*.out
*.exp
*.lib
*.pyd.debug

# Test / bench scratch output
tests/*.log
tests/npfc_bench_*.csv
!tests/npfc_bench_data_20000.csv

# Logs & probe/scratch output (root and subdirs)
*.log
*.out.txt

# R reference/benchmark generators (provenance only). They invoke the live R
# npfixedcomp2 package to (re)derive the committed reference values
# (tests/npfc_*_ref.csv, gold_cvmadcll.txt, ...) or re-time R for docs/PERF.md.
# Not imported by any Python test (run_all_verify.py only runs verify_*.py
# against the committed references), so they are untracked but kept on local
# disk for regeneration if the R package or data ever changes. Ignored so R
# drops out of the GitHub language stats.
tests/*.R
